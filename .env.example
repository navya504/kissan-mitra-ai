# Copy this file to .env or .env.local (both git-ignored) and fill in your keys.
# These are read only by the server routes in src/app/api/ and never ship in the app bundle.

# Nebius Token Factory: crop disease diagnosis and assistant replies
NEBIUS_API_KEY=
# Optional: any vision model from Nebius Token Factory
NEBIUS_VISION_MODEL=moonshotai/Kimi-K3
# Optional: any chat model from Nebius Token Factory
NEBIUS_CHAT_MODEL=moonshotai/Kimi-K3

# Sarvam AI: speech-to-text and spoken replies in Indian languages
SARVAM_API_KEY=
# Optional: Bulbul v3 voice, e.g. shubh, priya, kavya, rahul
SARVAM_SPEAKER=shubh
